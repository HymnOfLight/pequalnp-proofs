private theorem energyBudget
    (U short long : ℕ → (ℕ → ℝ) → ℝ) (high : ℕ → ℕ → ℝ) (model : ℕ → ℝ)
    (expand : ∀ n a, U n a = short n a + long n a)
    (hm : ∃ N : ℕ, ∀ n ≥ N, Even n → U n model ≤ (n:ℝ)/2304)
    (hs : ∃ N : ℕ, ∀ n ≥ N, Even n → |short n (high n) - short n model| ≤ (n:ℝ)/2304)
    (hl : ∃ N : ℕ, ∀ n ≥ N, Even n → long n (high n) - long n model ≤ (n:ℝ)/1152) :
    ∃ N : ℕ, ∀ n ≥ N, Even n → U n (high n) ≤ (n:ℝ)/576 := by
  obtain ⟨M,hm⟩ := hm
  obtain ⟨S,hs⟩ := hs
  obtain ⟨L,hl⟩ := hl
  refine ⟨max M (max S L), ?_⟩
  intro n hn he
  have m := hm n (by omega) he
  have s := (abs_le.mp (hs n (by omega) he)).2
  have l := hl n (by omega) he
  rw [expand n model] at m
  rw [expand n (high n)]
  linarith

